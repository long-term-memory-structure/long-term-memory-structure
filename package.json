{
  "name": "long-term-memory-structure",
  "version": "0.2.0",
  "description": "The record layer of long-term memory for Claude Code agents: index, search and pin session transcripts across compactions, without printing their content; pinned copies outlast the 30-day cleanup. No network, no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "pin": [
        "./dist/pin.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pin": {
      "types": "./dist/pin.d.ts",
      "default": "./dist/pin.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./package": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "ltms": "dist/cli.js",
    "long-term-memory-structure": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --test test/cli.test.mjs test/package-paths.test.mjs test/library-docs.test.mjs test/library.test.mjs test/search.test.mjs test/index.test.mjs test/skill.test.mjs test/pin.test.mjs test/bashverb-limit.test.mjs test/sieve.test.mjs"
  },
  "keywords": [
    "claude-code",
    "claude",
    "agent-memory",
    "long-term-memory",
    "memory",
    "ai-agent",
    "transcript",
    "session",
    "compaction",
    "context-window",
    "search",
    "pin",
    "jsonl",
    "privacy",
    "cli"
  ],
  "author": "Ohav Ben Yanai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.17.10",
    "typescript": "5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/long-term-memory-structure/long-term-memory-structure.git"
  },
  "homepage": "https://github.com/long-term-memory-structure/long-term-memory-structure#readme",
  "bugs": {
    "url": "https://github.com/long-term-memory-structure/long-term-memory-structure/issues"
  }
}
